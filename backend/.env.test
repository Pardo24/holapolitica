# Safe-default test environment for CI and local pytest runs.
# This file is checked in. NEVER put real secrets here.
#
# Pytest auto-loads .env via pydantic-settings; we point Postgres at the
# CI service containers in backend-ci.yml. For local pytest you can either
# rely on the default Postgres on localhost or run docker-compose up
# postgres redis first.

ENVIRONMENT=development
SECRET_KEY=ci-test-key-not-secret

# Backend service containers in CI live on localhost. Use the same DSNs
# locally if you run `docker-compose up postgres redis` and bind to the
# default ports.
DATABASE_URL=postgresql+asyncpg://monitor:monitor@localhost:5432/monitor_parlamentari_test
REDIS_URL=redis://redis:6379/0

# Classifier: the "keyword" provider runs entirely offline — no API key,
# no network, deterministic output. Real LLM provider integration is
# exercised manually, never in CI.
LLM_PROVIDER=keyword
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Listmonk newsletter: unset means "not configured". Tests for the digest
# pipeline build a fake client; production wiring is exercised manually.
LISTMONK_BASE_URL=
LISTMONK_API_USER=
LISTMONK_API_KEY=
LISTMONK_LIST_ID=
