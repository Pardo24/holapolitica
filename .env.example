# ============================================================================
# Monitor Parlamentari — environment variables
# Copy this file to .env and fill in the values. NEVER commit .env to git.
# ============================================================================

# ---- Database ------------------------------------------------------------
POSTGRES_USER=monitor
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=monitor_parlamentari
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend reads this directly:
DATABASE_URL=postgresql+asyncpg://monitor:change_me_in_production@postgres:5432/monitor_parlamentari

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Backend -------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key for JWT (only used for admin auth, not user-facing).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=please_generate_a_real_secret_key

# ---- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- LLM for topic classification ----------------------------------------
# Choose ONE of: mistral | anthropic | local_qwen
# (See app/classify/providers.py for details.)
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
QWEN_BASE_URL=http://localhost:11434

# ---- Email (alerts and double opt-in confirmations) ----------------------
# Provider: smtp | mailgun | resend | listmonk
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.org
SMTP_FROM_NAME=Monitor Parlamentari

# ---- Newsletter (Listmonk integration) -----------------------------------
LISTMONK_BASE_URL=
LISTMONK_API_USER=
LISTMONK_API_KEY=
LISTMONK_LIST_ID=

# ---- External data sources -----------------------------------------------
# Host root of the Congreso open data portal. The client joins listing paths
# like /es/opendata/diputados and resolves file links served from
# /webpublica/opendata/.
CONGRESO_OPENDATA_BASE_URL=https://www.congreso.es
CONGRESO_USER_AGENT=monitor-parlamentari/0.1 (+https://example.org)

# ---- Web Push (VAPID) ----------------------------------------------------
# Generate ONE permanent keypair with:
#   docker compose exec backend python -m app.services.push_keys
# Public key is safe to commit / surface via the /push/public-key endpoint;
# the private key MUST stay secret (it signs the JWT to the push service).
VAPID_PUBLIC_KEY=BGj96sZGfu9s7YtPu_Pd-eY_pZMyEg1y94y6LccR1udPj8go-ryKZM6FSyPJ_n5052rRG1ghxWs41KaM1zS52CE
VAPID_PRIVATE_KEY=
# mailto: or https: URL identifying this application server to the push
# service (RFC 8292). Used in the VAPID JWT `sub` claim.
VAPID_SUBJECT=mailto:noreply@monitorparlamentari.cat

# ---- Operational ---------------------------------------------------------
ENVIRONMENT=development
SENTRY_DSN=
